APP_NAME="Meu Canto"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Luanda

# Desenvolvimento local (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meu_canto
DB_USER=root
DB_PASS=
DB_SSL=false
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# TiDB Cloud (produção): usa os valores apresentados no botão Connect
# DB_HOST=gateway01.xxxxx.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=meu_canto
# DB_USER=utilizador_fornecido_pelo_tidb
# DB_PASS=palavra-passe-do-tidb
# DB_SSL=true
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Primeiro administrador (define apenas no ambiente privado do Render)
ADMIN_NAME="Administrador Meu Canto"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IA opcional, compatível com API OpenAI Chat Completions
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini

PRIVATE_STORAGE=storage/private
